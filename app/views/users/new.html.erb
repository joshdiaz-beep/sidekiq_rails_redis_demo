<h1>Create a User</h1>

<%= form_with model: @user, local: true do |form| %>
  <% if @user.errors.any? %>
    <div style="color: red;">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.submit "Create User" %>
  </div>
<% end %>

<p><%= link_to "View all users", users_path %></p>
<p><a href="/sidekiq" target="_blank">Open Sidekiq dashboard</a></p>
